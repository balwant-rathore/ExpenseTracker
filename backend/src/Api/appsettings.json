{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ExpenseTracker",
    "Audience": "ExpenseTracker",
    "AccessTokenLifetimeMinutes": 15
  },
  "RefreshToken": {
    "LifetimeDays": 7
  },
  "PasswordReset": {
    "OtpExpiryMinutes": 10
  },
  "RateLimiting": {
    "AuthEndpoints": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    }
  }
}
