{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ExpenseTracker",
    "Audience": "ExpenseTracker",
    "AccessTokenLifetimeMinutes": 15
  },
  "RefreshToken": {
    "LifetimeDays": 7
  },
  "PasswordReset": {
    "OtpExpiryMinutes": 10
  },
  "RateLimiting": {
    "AuthEndpoints": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    }
  },
  "Storage": {
    "AttachmentsRootPath": "storage/attachments"
  },
  "AttachmentCleanup": {
    "IntervalMinutes": 60,
    "OrphanThresholdHours": 24
  },
  "CompanyTimeZone": {
    "TimeZoneId": "Asia/Kolkata"
  },
  "Notification": {
    "LogDirectory": "storage/notifications",
    "LogFileName": "notifications.html",
    "TimestampFormat": "yyyy-MM-dd HH:mm:ss 'UTC'"
  }
}
